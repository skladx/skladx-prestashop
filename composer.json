{
    "name": "skladx/skladx-prestashop",
    "description": "SkladX fulfilment integration for PrestaShop 8 and 9.",
    "type": "prestashop-module",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "SkladX",
            "homepage": "https://skladx.sk"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "prestashop/php-dev-tools": "^5.0"
    },
    "autoload-dev": {
        "psr-4": {
            "SkladX\\PrestaShop\\": "src/",
            "SkladX\\PrestaShop\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "prepend-autoloader": false
    }
}
